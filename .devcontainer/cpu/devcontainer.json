// For format details, see https://aka.ms/devcontainer.json.
{
	"name": "Diff-Voyn",
	"dockerComposeFile": "../docker-compose.yaml",
	"service": "diffvoyn-cpu",
	"runServices": ["diffvoyn-cpu"],
	"workspaceFolder": "/workspace",
	"remoteEnv": {
		"LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}",
		"GIT_AUTHOR_EMAIL": "${localEnv:GIT_AUTHOR_EMAIL}",
		"GIT_AUTHOR_NAME": "${localEnv:GIT_AUTHOR_NAME}",
		"GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}",
		"WANDB_API_KEY":"${localEnv:WANDB_API_KEY}",
		"HF_TOKEN":"${localEnv:HF_TOKEN}",
		"HF_HOME": "/workspace/data/hf-models",
		"CLEARML_API_HOST":"${localEnv:CLEARML_API_HOST}",
		"CLEARML_WEB_HOST":"${localEnv:CLEARML_WEB_HOST}",
		"CLEARML_FILES_HOST":"${localEnv:CLEARML_FILES_HOST}",
		"CLEARML_API_ACCESS_KEY":"${localEnv:CLEARML_API_ACCESS_KEY}",
		"CLEARML_API_SECRET_KEY":"${localEnv:CLEARML_API_SECRET_KEY}"
	},

	"features": {
		"ghcr.io/devcontainers/features/common-utils:2": {
			"configureZshAsDefaultShell":true,
			"username":"vscode",
			"userUid":1000,
			"userGid":1000
		}
	},

	// Configure tool-specific properties.
	"customizations": {
		// Configure properties specific to VS Code.
		"vscode": {
			// Set *default* container specific settings.json values on container create.
			"settings": {
				"python.defaultInterpreterPath": "/workspace/.venv/bin/python",
				"python.analysis.extraPaths": [
					"/workspace",
					"/workspace/src"
				]
			},

			// Add the IDs of extensions you want installed when the container is created.
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"streetsidesoftware.code-spell-checker",
				"github.copilot",
				"GitHub.vscode-pull-request-github",
				"ms-vsliveshare.vsliveshare",
				"charliermarsh.ruff",
				"ms-toolsai.jupyter",
				"mohsen1.prettify-json",
				"ms-toolsai.vscode-jupyter-powertoys",
				"ms-toolsai.jupyter-keymap",
				"ms-toolsai.datawrangler"
			]
		}
	},

	// run the `.devcontainer/post-create.sh` script
	"postCreateCommand": "bash /workspace/.devcontainer/post-create.sh",
	// Comment out to connect as root instead. More info: https://aka.ms/vscode-remote/containers/non-root.
    "remoteUser": "vscode"
}
