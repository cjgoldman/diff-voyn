#!/usr/bin/env bash
# Documentation coherence gate (see scripts/doc_coherence_check.py). Installed by
# .devcontainer/post-create.sh via `git config core.hooksPath .githooks`.
# Bypass for a genuinely unrelated emergency commit: git commit --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1
if command -v uv >/dev/null 2>&1; then
  uv run python scripts/doc_coherence_check.py
else
  python3 scripts/doc_coherence_check.py
fi
